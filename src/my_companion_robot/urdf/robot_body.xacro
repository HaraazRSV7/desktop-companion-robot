<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    
    

    
    <link name="base_link">
        <visual>
            <geometry>
                <mesh  filename="package://my_companion_robot/meshes/base_edited.stl"
                scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="0.054 0.08 0.034 "/>
            </geometry>
            <origin xyz="0 0 0.018" rpy="0 0 0" />
        </collision>

        <inertial>
            
            <origin xyz="0 0 0.018" rpy="0 0 0"/>
            <mass value="0.038"/>
            <inertia
                ixx="3.1321e-05"
                ixy="-2.7215e-08"
                ixz="1.0147e-08"
                iyy="1.9849e-05"
                iyz="-2.7365e-07"
                izz="3.9200e-05"/>

        </inertial>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <mesh filename="package://my_companion_robot/meshes/wheel.stl"
                          scale="0.001 0.001 0.001" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.021" length="0.01" />
                </geometry>
                <origin xyz="0.005 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}" />
            </collision>
            <inertial>
                <origin xyz="0.005 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>

                <mass value="0.018"/>

                <inertia
                    ixx="1.24355e-06"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="1.24349e-06"
                    iyz="0.0"
                    izz="2.22070e-06"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />



     <link name="castor_wheel_link">
        <visual>
            <geometry>
                <mesh filename="package://my_companion_robot/meshes/castor_wheel.stl"
                          scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.012" length="0.022"/>
            </geometry>
            <origin xyz="0 0 0.013" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0.013" rpy="0 0 0"/>

            <mass value="0.016"/>

            <inertia
                ixx="8.82630e-07"
                ixy="0.0"
                ixz="0.0"
                iyy="8.82619e-07"
                iyz="0.0"
                izz="5.89002e-07"/>
        </inertial>
    </link>


    <link name="base_footprint" />


    <link name="lid_link">
        <visual>
            <geometry>
                <mesh filename="package://my_companion_robot/meshes/lid_edited.stl"
                          scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        
    </link>


    <link name="oled_bezel_link">
        <visual>
            <geometry>
                <mesh filename="package://my_companion_robot/meshes/Bezel_OLEDyebl_096.stl"
                      scale="0.001 0.001 0.001"/>
            </geometry>

            <material name="grey"/>
        </visual>
        <!-- <collision>
            <geometry>
                <box size="0.03 0.03 0.006" />
            </geometry>
            <origin xyz="0 0 0.003" rpy="0 0 0" />
        </collision> -->

    </link>
       


    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0.027 0.02 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="-0.037 0.02 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
    </joint>

    <joint name="base_lid_joint" type="fixed">
        <parent link="base_link" />
        <child link="lid_link" />
        <origin xyz="-0.0359 -0.016 0.032" rpy="0 0 0" />
        
    </joint>



    <joint name="base_oled_bezel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="oled_bezel_link"/>
        <origin xyz="0 -0.04 0.016" rpy="-${pi / 2} ${pi} 0"/>
    </joint>

    
    <joint name="base_castor_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="castor_wheel_link" />
        <origin xyz="0 -0.018 -0.0185" rpy="0 0 0" />
        
    </joint>

    <joint name="base_base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.0185" rpy="0 0 0" />
    </joint>  

    
    
</robot>